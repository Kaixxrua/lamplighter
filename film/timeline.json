 "cards": [
  {
   "id": "c1",
   "start": 84,
   "end": 204,
   "fadeIn": 18,
   "fadeOut": 12,
   "layers": [
    {
     "zh": "日光之下，并无新事。",
     "en": "There is nothing new under the sun.",
     "attribZh": "——《传道书》1:9",
     "attribEn": "Ecclesiastes 1:9",
     "delay": 0
    }
   ]
  },
  {
   "id": "c2",
   "start": 522,
   "end": 636,
   "fadeIn": 18,
   "fadeOut": 12,
   "layers": [
    {
     "zh": "每一天，人与机器写下的，都比前一天更多。",
     "en": "Every day, humans and machines write more than the day before.",
     "delay": 0
    }
   ]
  },
  {
   "id": "c3",
   "start": 658,
   "end": 788,
   "fadeIn": 18,
   "fadeOut": 12,
   "layers": [
    {
     "zh": "一切都已写下。",
     "en": "Everything has been written.",
     "delay": 0
    },
    {
     "zh": "却没有人找得到。",
     "en": "And no one can find any of it.",
     "delay": 36
    }
   ]
  },
  {
   "id": "c4",
   "start": 2248,
   "end": 2370,
   "fadeIn": 18,
   "fadeOut": 12,
   "layers": [
    {
     "zh": "每天早上八点，世界被读成一封信。",
     "en": "Every morning at eight, the world is read into a single letter.",
     "delay": 0
    }
   ]
  },
  {
   "id": "c5",
   "start": 2772,
   "end": 2894,
   "fadeIn": 18,
   "fadeOut": 12,
   "layers": [
    {
     "zh": "如今，来读书的不只有人。",
     "en": "Today, not every reader is human.",
     "delay": 0
    }
   ]
  },
  {
   "id": "c6",
   "start": 3342,
   "end": 3428,
   "fadeIn": 18,
   "fadeOut": 12,
   "layers": [
    {
     "zh": "它在写一本早已有人写过的书。",
     "en": "It is writing a book that has already been written.",
     "delay": 0
    }
   ]
  },
  {
   "id": "c7",
   "start": 4206,
   "end": 4292,
   "fadeIn": 18,
   "fadeOut": 12,
   "layers": [
    {
     "zh": "它留下一盏灯，给下一个读者。",
     "en": "It leaves a light on for the next reader.",
     "delay": 0
    }
   ]
  },
  {
   "id": "c8",
   "start": 5004,
   "end": 5148,
   "fadeIn": 18,
   "fadeOut": 12,
   "layers": [
    {
     "zh": "宇宙（别人称之为图书馆）",
     "en": "The universe (which others call the Library)",
     "attribZh": "——博尔赫斯",
     "attribEn": "Jorge Luis Borges",
     "delay": 0
    }
   ]
  },
  {
   "id": "c9",
   "start": 5172,
   "end": 5300,
   "fadeIn": 18,
   "fadeOut": 12,
   "layers": [
    {
     "zh": "日光之下，并无新事。",
     "en": "There is nothing new under the sun.",
     "delay": 0
    },
    {
     "zh": "但总有人，为后来者点灯。",
     "en": "But someone always leaves a light on for those who come after.",
     "delay": 36
    }
   ]
  },
